{
  "name": "nanowarp",
  "version": "1.0.4",
  "description": "Lightning-fast API framework with hot-swappable file-based endpoints (works with Bun and Node.js)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "nanowarp-init": "./dist/cli/init.js",
    "nanowarp-migrate": "./dist/cli/migrate.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "bun test",
    "example": "bun examples/server.ts",
    "example:node": "tsx examples/server.ts",
    "init": "bun src/cli/init.ts",
    "migrate": "bun src/cli/migrate.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "api",
    "framework",
    "bun",
    "node",
    "nodejs",
    "hot-reload",
    "file-based",
    "endpoints",
    "lightweight",
    "microservice",
    "rest-api",
    "typescript",
    "cross-runtime"
  ],
  "author": "ncwardell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncwardell/NanoWarp.git"
  },
  "bugs": {
    "url": "https://github.com/ncwardell/NanoWarp/issues"
  },
  "homepage": "https://github.com/ncwardell/NanoWarp#readme",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.2",
    "pg": "^8.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "fs-extra": "^11.2.0"
  }
}
